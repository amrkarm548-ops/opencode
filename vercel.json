{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm i -g bun@1.4.4 && bun install --frozen-lockfile",
  "buildCommand": "VITE_OPENCODE_SERVER_MODE=none bun --cwd packages/app build && find packages/app/dist -name '*.map' -delete",
  "outputDirectory": "packages/app/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
