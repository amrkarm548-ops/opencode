{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm i -g bun@1.4.4 && bun install --frozen-lockfile",
  "buildCommand": "bun --cwd packages/app build && find packages/app/dist -name '*.map' -delete",
  "outputDirectory": "packages/app/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/opencode.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/opencode" },
    { "source": "/auth/(.*)", "destination": "/api/opencode" },
    { "source": "/openapi.json", "destination": "/api/opencode" },
    { "source": "/event", "destination": "/api/opencode" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
