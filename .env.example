# Public DNS name pointing to this server. Ports 80 and 443 must be open for HTTPS.
OPENCODE_DOMAIN=opencode.example.com

# Replace with a unique, long random password. Keep this file local as .env.
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Put the OpenRouter key here on the server only. Never commit it or expose it as a VITE_* variable.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Host directory mounted as OpenCode's workspace. Defaults to ./workspace.
OPENCODE_WORKSPACE=./workspace
